#!/usr/bin/env bash

set -euo pipefail

# Paths and constants
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
HELPER="$SCRIPT_DIR/lib/preset-palette.py"

# shellcheck source=lib/apply-colors.sh
source "$SCRIPT_DIR/lib/apply-colors.sh"

usage() {
    echo "Usage: $(basename "$0") <scheme>/<flavour>   (e.g. gruvbox/medium)" >&2
    echo "       $(basename "$0") dynamic              (back to wallpaper colours)" >&2
    echo "       $(basename "$0") --random             (any preset, or dynamic)" >&2
    echo "       $(basename "$0") --list" >&2
    exit 1
}

[[ $# -eq 1 ]] || usage

case "$1" in
    --list) exec "$HELPER" list ;;
    --random)
        mapfile -t CHOICES < <("$HELPER" list | cut -f1)
        [[ ${#CHOICES[@]} -gt 0 ]] || { echo "setscheme: no presets found" >&2; exit 1; }
        # Wallpaper colours are in the draw
        CHOICES+=(dynamic)
        TARGET="${CHOICES[RANDOM % ${#CHOICES[@]}]}"
        echo "setscheme: random pick: $TARGET"
        ;;
    -*)     usage ;;
    *)      TARGET="$1" ;;
esac

for bin in matugen jq gsettings hyprctl; do
    command -v "$bin" >/dev/null || { echo "setscheme: missing required binary: $bin" >&2; exit 1; }
done

mkdir -p "$CACHE_DIR" "$(dirname "$SOURCE_FILE")"

# Delegate to switchwall
if [[ "$TARGET" == dynamic ]]; then
    printf '%s' dynamic > "$SOURCE_FILE"
    exec switchwall --noswitch
fi

# Resolve mode
STORED_MODE=""
[[ -s "$MODE_FILE" ]] && STORED_MODE="$(cat "$MODE_FILE")"
WANT_MODE="${STORED_MODE:-dark}"
[[ "$WANT_MODE" == auto ]] && WANT_MODE=dark

AVAILABLE="$("$HELPER" modes "$TARGET")" || { echo "setscheme: unknown preset '$TARGET'" >&2; exit 1; }
MODE="$WANT_MODE"
[[ " $AVAILABLE " == *" $WANT_MODE "* ]] || {
    MODE="${AVAILABLE%% *}"
    echo "setscheme: $TARGET has no $WANT_MODE mode, using $MODE"
}

# Role drift guard
"$HELPER" check || echo "setscheme: colour role lists disagree (see above)" >&2

# Validate before writing
palette="$CACHE_DIR/preset_palette.json"
scss="$CACHE_DIR/preset_colors.scss"
trap 'rm -f "$palette.part" "$scss.part"' EXIT
"$HELPER" matugen "$TARGET" "$MODE" > "$palette.part"
"$HELPER" scss "$TARGET" "$MODE" > "$scss.part"
mv "$palette.part" "$palette"
mv "$scss.part" "$scss"

# Same templates as wallpaper
matugen json "$palette"

apply_kitty_from_scss "$scss"
apply_gsettings "$MODE"
apply_qt "$MODE"

# Keep auto for dynamic
[[ "$STORED_MODE" == auto ]] || printf '%s' "$MODE" > "$MODE_FILE"
printf '%s' "$TARGET" > "$SOURCE_FILE"

reload_all

echo "setscheme: done ($TARGET $MODE)"
