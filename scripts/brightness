#!/usr/bin/env python3
"""Adjust the laptop backlight through the active login session."""
from pathlib import Path
import subprocess
import sys

if len(sys.argv) != 2 or sys.argv[1] not in ("up", "down"):
    raise SystemExit("Usage: brightness up|down")
devices = sorted(Path("/sys/class/backlight").iterdir())
if not devices:
    raise SystemExit("No laptop backlight found")
device = devices[0]
maximum = int((device / "max_brightness").read_text())
current = int((device / "brightness").read_text())
step = max(1, round(maximum * 0.05))
target = max(max(1, round(maximum * 0.01)), min(maximum, current + (step if sys.argv[1] == "up" else -step)))
subprocess.run([
    "busctl", "call", "org.freedesktop.login1",
    "/org/freedesktop/login1/session/auto", "org.freedesktop.login1.Session",
    "SetBrightness", "ssu", "backlight", device.name, str(target),
], check=True)
