#!/usr/bin/env bash

set -euo pipefail

usage() {
    echo "usage: record <region|full|stop> [--sound]" >&2
    exit 1
}

# Parse args
MODE="${1:-}"
SOUND=false
[[ "${2:-}" == "--sound" ]] && SOUND=true

case "$MODE" in
    region|full|stop) ;;
    *) usage ;;
esac

# Dependency preflight
for bin in wf-recorder pactl notify-send; do
    command -v "$bin" >/dev/null || { echo "record: missing required binary: $bin" >&2; exit 1; }
done
if [[ "$MODE" == region ]] && ! command -v slurp >/dev/null; then
    echo "record: region mode requires slurp, which isn't installed" >&2
    exit 1
fi

is_recording() { pgrep -x wf-recorder >/dev/null; }

stop_recording() {
    pkill -INT -x wf-recorder
    notify-send -a record "Recording stopped" || true
}

# Stop mode / toggle-off
if [[ "$MODE" == stop ]]; then
    is_recording && stop_recording
    exit 0
fi

if is_recording; then
    stop_recording
    exit 0
fi

# Build wf-recorder args
SAVE_DIR="$HOME/Videos"
mkdir -p "$SAVE_DIR"
OUTFILE="$SAVE_DIR/Recording_$(date +%Y-%m-%d_%H.%M.%S).mp4"

args=(--pixel-format yuv420p -f "$OUTFILE")

if [[ "$MODE" == region ]]; then
    region="$(slurp)" || { notify-send -a record "Recording cancelled" "No region selected" || true; exit 0; }
    [[ -z "$region" ]] && { notify-send -a record "Recording cancelled" "No region selected" || true; exit 0; }
    args+=(-g "$region")
else
    mon="$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name')"
    args+=(-o "$mon")
fi

if $SOUND; then
    sink="$(pactl get-default-sink)"
    args+=(-a "${sink}.monitor")
fi

# Launch
wf-recorder "${args[@]}" >"$SAVE_DIR/.wf-recorder.log" 2>&1 &
disown
notify-send -a record "Recording started" "$OUTFILE" || true
