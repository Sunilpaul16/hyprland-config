#!/usr/bin/env bash


set -euo pipefail

# Paths and constants
HYPR_GENERAL="$HOME/.config/hypr/general.lua"
mapfile -t MONITORS < <(grep -oP 'hl\.monitor\(\{\s*output\s*=\s*"\K[^"]+' "$HYPR_GENERAL")
[[ ${#MONITORS[@]} -gt 0 ]] || { echo "switchwall: no monitors found in $HYPR_GENERAL" >&2; exit 1; }
VENV_PYTHON="$HOME/.local/state/quickshell/.venv/bin/python3"
COLORGEN_DIR="$HOME/.config/matugen/colorgen"
CACHE_DIR="$HOME/.cache/matugen"
KITTY_THEME_OUT="$HOME/.config/kitty/theme.conf"

STATE_FILE="$HOME/.local/state/quickshell/current_wallpaper"
MODE_FILE="$HOME/.local/state/quickshell/color_mode"
# The shell's settings panel writes these; read rather than duplicate them
# into another state file, so there is one source of truth per value
CONFIG_FILE="$HOME/.config/quickshell/config.json"
# Palette-only matugen config; see matugen/preview.toml for why it is separate
PREVIEW_CONFIG="$HOME/.config/matugen/preview.toml"
PREVIEW_COLORS="$HOME/.cache/matugen/preview-colors.json"

VALID_SCHEMES="scheme-tonal-spot scheme-vibrant scheme-expressive scheme-content scheme-fidelity scheme-fruit-salad scheme-monochrome scheme-neutral scheme-rainbow"

# cfg <jq-path> <default> — missing file, missing key or null all fall back
cfg() {
    local value=""
    if [[ -s "$CONFIG_FILE" ]]; then
        value="$(jq -r "$1 // empty" "$CONFIG_FILE" 2>/dev/null || true)"
    fi
    [[ -n "$value" ]] && printf '%s' "$value" || printf '%s' "$2"
}

MPV_OPTS="no-audio loop hwdec=auto scale=bilinear interpolation=no video-sync=display-resample panscan=1.0 video-scale-x=1.0 video-scale-y=1.0 video-align-x=0.5 video-align-y=0.5 load-scripts=no"

usage() {
    echo "Usage: $(basename "$0") [--preview] [--mode auto|light|dark] [--scheme auto|scheme-*] <path-to-image-or-video>" >&2
    echo "       $(basename "$0") --noswitch" >&2
    echo "       $(basename "$0") --colors-preview <path>   (palette only, changes nothing)" >&2
    echo "       $(basename "$0") --mode auto|light|dark   (re-themes the current wallpaper)" >&2
    exit 1
}

is_video() {
    case "${1##*.}" in
        mp4|webm|mkv|avi|mov) return 0 ;;
        *) return 1 ;;
    esac
}

# Parse args
PREVIEW=false
COLORS_PREVIEW=false
NOSWITCH=false
SET_MODE=""
SET_SCHEME=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --preview)  PREVIEW=true; shift ;;
        --colors-preview) COLORS_PREVIEW=true; shift ;;
        --noswitch) NOSWITCH=true; shift ;;
        --mode)     [[ -n "${2:-}" ]] || usage; SET_MODE="$2"; shift 2 ;;
        --scheme)   [[ -n "${2:-}" ]] || usage; SET_SCHEME="$2"; shift 2 ;;
        --)         shift; break ;;
        -*)         usage ;;
        *)          break ;;
    esac
done

# Persisted override; bare --mode re-themes the current wallpaper in place
if [[ -n "$SET_MODE" ]]; then
    case "$SET_MODE" in
        auto|light|dark) ;;
        *) echo "switchwall: --mode must be auto, light or dark (got: $SET_MODE)" >&2; exit 1 ;;
    esac
    mkdir -p "$(dirname "$MODE_FILE")"
    printf '%s' "$SET_MODE" > "$MODE_FILE"
    if [[ $# -eq 0 ]] && ! $PREVIEW; then
        NOSWITCH=true
    fi
fi

COLOR_MODE=auto
if [[ -s "$MODE_FILE" ]]; then
    COLOR_MODE="$(cat "$MODE_FILE")"
fi

if $COLORS_PREVIEW; then
    [[ $# -eq 1 ]] || usage
    wallpaper="$1"
    [[ -f "$wallpaper" ]] || { echo "switchwall: no such file: $wallpaper" >&2; exit 1; }
elif $NOSWITCH; then
    [[ $# -eq 0 ]] || usage
    [[ -s "$STATE_FILE" ]] || { echo "switchwall: --noswitch given but no wallpaper is set yet ($STATE_FILE missing/empty)" >&2; exit 1; }
    wallpaper="$(cat "$STATE_FILE")"
    [[ -f "$wallpaper" ]] || { echo "switchwall: stored wallpaper no longer exists: $wallpaper" >&2; exit 1; }
else
    [[ $# -eq 1 ]] || usage
    wallpaper="$1"
    [[ -f "$wallpaper" ]] || { echo "switchwall: no such file: $wallpaper" >&2; exit 1; }
fi

# Dependency preflight
command -v mpvpaper >/dev/null || { echo "switchwall: missing required binary: mpvpaper" >&2; exit 1; }
if ! $PREVIEW; then
    for bin in matugen ffmpeg gsettings jq; do
        command -v "$bin" >/dev/null || { echo "switchwall: missing required binary: $bin" >&2; exit 1; }
    done
    [[ -x "$VENV_PYTHON" ]] || { echo "switchwall: venv python not found at $VENV_PYTHON" >&2; exit 1; }
fi

mkdir -p "$CACHE_DIR"

# --- 1. Wallpaper display: mpvpaper on both monitors ------------------------
if ! $NOSWITCH && ! $COLORS_PREVIEW; then
    pkill -f -9 mpvpaper >/dev/null 2>&1 || true
    for mon in "${MONITORS[@]}"; do
        mpvpaper -o "$MPV_OPTS" "$mon" "$wallpaper" &
        sleep 0.1
    done
fi

if $PREVIEW; then
    echo "switchwall: preview only ($wallpaper)"
    exit 0
fi

if ! $COLORS_PREVIEW; then
    mkdir -p "$(dirname "$STATE_FILE")"
    printf '%s' "$wallpaper" > "$STATE_FILE"
fi

# --- 2. Color source: extract a frame if it's a video -----------------------
colorsource="$wallpaper"
lumsource="$wallpaper"
if is_video "$wallpaper"; then
    frame="$CACHE_DIR/$(basename "$wallpaper").frame.jpg"
    ffmpeg -y -i "$wallpaper" -vframes 1 "$frame" >/dev/null 2>&1
    [[ -s "$frame" ]] || { echo "switchwall: ffmpeg failed to extract a frame from $wallpaper" >&2; exit 1; }
    colorsource="$frame"

    # Brightness only: frame 0 is often a near-white title card, which would
    # flip the whole desktop to light mode. Accent still comes from frame 0.
    lumframe="$CACHE_DIR/$(basename "$wallpaper").lum.jpg"
    ffmpeg -y -ss 00:00:01 -i "$wallpaper" -frames:v 1 "$lumframe" >/dev/null 2>&1 || true
    if [[ -s "$lumframe" ]]; then
        lumsource="$lumframe"
    else
        lumsource="$frame"
    fi
fi

# --- 3. matugen: hyprlock / hyprland colors.lua / GTK3+4 css ----------------

# Resolved once here so both engines below agree: matugen has neither --smart
# nor brightness-based mode selection of its own, so a low-chroma or bright
# wallpaper would otherwise only affect kitty.
# "auto" keeps the previous behaviour: --smart lets the generator pick a
# scheme from the image. A named scheme drops --smart so the choice sticks.
SCHEME_PREF="${SET_SCHEME:-$(cfg '.theming.scheme' 'auto')}"
if [[ "$SCHEME_PREF" != auto ]] && [[ " $VALID_SCHEMES " != *" $SCHEME_PREF "* ]]; then
    echo "switchwall: unknown scheme '$SCHEME_PREF', falling back to auto" >&2
    SCHEME_PREF=auto
fi

SCHEME_ARGS=(--scheme scheme-tonal-spot --smart)
[[ "$SCHEME_PREF" != auto ]] && SCHEME_ARGS=(--scheme "$SCHEME_PREF")

mapfile -t RESOLVED < <("$VENV_PYTHON" "$COLORGEN_DIR/generate_colors_material.py" \
    --path "$colorsource" \
    --luminance-path "$lumsource" \
    "${SCHEME_ARGS[@]}" \
    --mode "$COLOR_MODE" \
    --print-scheme \
    --print-mode)
[[ ${#RESOLVED[@]} -eq 2 ]] || { echo "switchwall: failed to resolve scheme/mode" >&2; exit 1; }
SCHEME="${RESOLVED[0]}"
MODE="${RESOLVED[1]}"

if $COLORS_PREVIEW; then
    matugen image "$colorsource" --config "$PREVIEW_CONFIG" \
        --source-color-index 0 --mode "$MODE" --type "$SCHEME" >/dev/null
    echo "switchwall: colours preview written ($wallpaper)"
    exit 0
fi

matugen image "$colorsource" --source-color-index 0 --mode "$MODE" --type "$SCHEME"


if [[ "$MODE" == light ]]; then
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-light'
else
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
fi


nautilus -q || true

# --- 4. materialyoucolor: kitty's 16-color terminal palette -----------------
# Terminal-only tuning; defaults match generate_colors_material.py's own, so
# an absent config behaves exactly as before this was configurable
TERM_HARMONY="$(cfg '.theming.terminalHarmony' '0.8')"
TERM_THRESHOLD="$(cfg '.theming.terminalHarmonizeThreshold' '100')"
TERM_FG_BOOST="$(cfg '.theming.terminalFgBoost' '0.35')"
TERM_FORCE_DARK="$(cfg '.theming.terminalForceDark' 'false')"

TERM_MODE="$MODE"
[[ "$TERM_FORCE_DARK" == true ]] && TERM_MODE=dark

scss="$CACHE_DIR/material_colors.scss"
"$VENV_PYTHON" "$COLORGEN_DIR/generate_colors_material.py" \
    --path "$colorsource" \
    --mode "$TERM_MODE" \
    --scheme "$SCHEME" \
    --termscheme "$COLORGEN_DIR/terminal/scheme-base.json" \
    --harmony "$TERM_HARMONY" \
    --harmonize_threshold "$TERM_THRESHOLD" \
    --term_fg_boost "$TERM_FG_BOOST" \
    --blend_bg_fg \
    > "$scss"

cp "$COLORGEN_DIR/terminal/kitty-theme.conf" "$KITTY_THEME_OUT"
while IFS=: read -r name value; do
    [[ -z "$name" ]] && continue
    hexval="$(echo "$value" | tr -d ' ;')"
    hexval="${hexval#\#}"
    sed -i "s/${name} #/${hexval}/g" "$KITTY_THEME_OUT"
done < "$scss"

# Terminal window transparency. dynamic_background_opacity is what lets kitty
# pick this up on SIGUSR1 instead of needing a restart
TERM_OPACITY="$(cfg '.theming.terminalOpacity' '1.0')"
{
    echo ""
    echo "# Written by switchwall from theming.terminalOpacity"
    echo "dynamic_background_opacity yes"
    echo "background_opacity $TERM_OPACITY"
} >> "$KITTY_THEME_OUT"

# --- 5. Reload ---------------------------------------------------------------
hyprctl reload >/dev/null
pkill -SIGUSR1 -x kitty >/dev/null 2>&1 || true

echo "switchwall: done ($wallpaper)"
