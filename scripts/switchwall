#!/usr/bin/env bash
# switchwall — set a wallpaper (image or video) and regenerate the matugen +
# materialyoucolor theming pipeline: hyprlock/fuzzel/hyprland colors via
# matugen, kitty's terminal palette via materialyoucolor, then reload.
#
# Usage: switchwall <path-to-image-or-video>
#
# Standalone precursor to end-4/dots-hyprland's switchwall.sh: no quickshell,
# no ~/.config/illogical-impulse/config.json, monitors are hardcoded to
# DP-3/DP-2 (see ~/.config/hypr/general.lua) instead of looped from
# `hyprctl monitors`. Revisit when quickshell is set up.
#
# Idempotent: safe to re-run with the same or a different wallpaper — always
# kills any previous mpvpaper before relaunching, and every generated file is
# fully overwritten (not appended to) on each run.
#
# --preview: only swap the displayed wallpaper (mpvpaper), skip matugen/
# kitty/gtk/hyprctl-reload entirely. Needed because the full pipeline
# regenerates ~/.config/quickshell/shell/services/Colors.qml, which lives inside the
# directory Quickshell hot-reloads on any change — running the full pipeline
# on every hover/arrow-key tick while browsing the wallpaper picker would
# reset the whole quickshell config (closing the picker) after the very
# first preview. --preview is for that live-browsing case; a plain
# (non---preview) call still does the full theming pipeline, used once the
# user actually confirms a choice.

set -euo pipefail

MONITORS=(DP-3 DP-2)
VENV_PYTHON="$HOME/.local/state/quickshell/.venv/bin/python3"
COLORGEN_DIR="$HOME/.config/matugen/colorgen"
CACHE_DIR="$HOME/.cache/matugen"
KITTY_THEME_OUT="$HOME/.config/kitty/theme.conf"
# Last-confirmed wallpaper path, replayed by hypr/execs.lua on login via
# `switchwall --preview` (mpvpaper only) since mpvpaper doesn't survive a
# session restart but the matugen-generated theme files already do.
STATE_FILE="$HOME/.local/state/quickshell/current_wallpaper"
# Same mpv options end-4's switchwall.sh uses for video wallpapers; reused
# as-is for static images too (mpv holds a single looped frame fine).
MPV_OPTS="no-audio loop hwdec=auto scale=bilinear interpolation=no video-sync=display-resample panscan=1.0 video-scale-x=1.0 video-scale-y=1.0 video-align-x=0.5 video-align-y=0.5 load-scripts=no"

usage() {
    echo "Usage: $(basename "$0") [--preview] <path-to-image-or-video>" >&2
    exit 1
}

PREVIEW=false
if [[ "${1:-}" == "--preview" ]]; then
    PREVIEW=true
    shift
fi

[[ $# -eq 1 ]] || usage
wallpaper="$1"
[[ -f "$wallpaper" ]] || { echo "switchwall: no such file: $wallpaper" >&2; exit 1; }

command -v mpvpaper >/dev/null || { echo "switchwall: missing required binary: mpvpaper" >&2; exit 1; }
if ! $PREVIEW; then
    for bin in matugen ffmpeg; do
        command -v "$bin" >/dev/null || { echo "switchwall: missing required binary: $bin" >&2; exit 1; }
    done
    [[ -x "$VENV_PYTHON" ]] || { echo "switchwall: venv python not found at $VENV_PYTHON" >&2; exit 1; }
fi

mkdir -p "$CACHE_DIR"

is_video() {
    case "${1##*.}" in
        mp4|webm|mkv|avi|mov) return 0 ;;
        *) return 1 ;;
    esac
}

# --- 1. Wallpaper display: mpvpaper on both monitors ------------------------
pkill -f -9 mpvpaper >/dev/null 2>&1 || true
for mon in "${MONITORS[@]}"; do
    mpvpaper -o "$MPV_OPTS" "$mon" "$wallpaper" &
    sleep 0.1
done

if $PREVIEW; then
    echo "switchwall: preview only ($wallpaper)"
    exit 0
fi

mkdir -p "$(dirname "$STATE_FILE")"
printf '%s' "$wallpaper" > "$STATE_FILE"

# --- 2. Color source: extract a frame if it's a video -----------------------
colorsource="$wallpaper"
if is_video "$wallpaper"; then
    frame="$CACHE_DIR/$(basename "$wallpaper").frame.jpg"
    ffmpeg -y -i "$wallpaper" -vframes 1 "$frame" >/dev/null 2>&1
    [[ -s "$frame" ]] || { echo "switchwall: ffmpeg failed to extract a frame from $wallpaper" >&2; exit 1; }
    colorsource="$frame"
fi

# --- 3. matugen: hyprlock / fuzzel / hyprland colors.lua / GTK3+4 css -------
# --source-color-index 0 picks the most dominant color deterministically
# (matugen prompts interactively otherwise when several candidates are close).
matugen image "$colorsource" --source-color-index 0 --mode dark

# Quit Nautilus so it picks up the regenerated gtk-3.0/gtk-4.0 css on next
# open (GTK doesn't hot-reload custom css into already-running instances).
nautilus -q || true

# --- 4. materialyoucolor: kitty's 16-color terminal palette -----------------
scss="$CACHE_DIR/material_colors.scss"
"$VENV_PYTHON" "$COLORGEN_DIR/generate_colors_material.py" \
    --path "$colorsource" \
    --mode dark \
    --scheme scheme-tonal-spot \
    --termscheme "$COLORGEN_DIR/terminal/scheme-base.json" \
    --blend_bg_fg \
    > "$scss"

cp "$COLORGEN_DIR/terminal/kitty-theme.conf" "$KITTY_THEME_OUT"
while IFS=: read -r name value; do
    [[ -z "$name" ]] && continue
    hexval="$(echo "$value" | tr -d ' ;')"
    hexval="${hexval#\#}"
    sed -i "s/${name} #/${hexval}/g" "$KITTY_THEME_OUT"
done < "$scss"

# --- 5. Reload ---------------------------------------------------------------
hyprctl reload >/dev/null
pkill -SIGUSR1 -x kitty >/dev/null 2>&1 || true

echo "switchwall: done ($wallpaper)"
