#!/usr/bin/env bash


set -euo pipefail

# Paths and constants
HYPR_GENERAL="$HOME/.config/hypr/general.lua"
VENV_PYTHON="$HOME/.local/state/quickshell/.venv/bin/python3"

# shellcheck source=lib/apply-colors.sh
source "$(dirname "$(readlink -f "$0")")/lib/apply-colors.sh"

STATE_FILE="$HOME/.local/state/quickshell/current_wallpaper"
FRAMING_FILE="$HOME/.local/state/quickshell/wallpaper_framing.json"
# Palette-only config
PREVIEW_CONFIG="$HOME/.config/matugen/preview.toml"
PREVIEW_COLORS="$HOME/.cache/matugen/preview-colors.json"

VALID_SCHEMES="scheme-tonal-spot scheme-vibrant scheme-expressive scheme-content scheme-fidelity scheme-fruit-salad scheme-monochrome scheme-neutral scheme-rainbow"

MPV_OPTS="quiet no-audio loop hwdec=auto scale=bilinear interpolation=no video-sync=display-resample panscan=1.0 video-scale-x=1.0 video-scale-y=1.0 video-align-y=0 load-scripts=no"

usage() {
    echo "Usage: $(basename "$0") [--preview] [--force-display] [--mode auto|light|dark] [--scheme auto|scheme-*] <path-to-image-or-video>" >&2
    echo "       $(basename "$0") --random      (pick a different local wallpaper)" >&2
    echo "       $(basename "$0") --login       (shuffle or restore according to settings)" >&2
    echo "       $(basename "$0") --noswitch" >&2
    echo "       $(basename "$0") --colors-preview <path>   (palette only, changes nothing)" >&2
    echo "       $(basename "$0") --mode auto|light|dark   (re-themes the current wallpaper)" >&2
    echo "       $(basename "$0") --refresh   (discards this wallpaper's cached frames and analysis)" >&2
    exit 1
}

is_video() {
    local ext="${1##*.}"
    case "${ext,,}" in
        mp4|webm|mkv|avi|mov) return 0 ;;
        *) return 1 ;;
    esac
}

stop_owned_mpvpaper() {
    local runtime_prefix="${XDG_RUNTIME_DIR:-/tmp}/mpvpaper-"
    local pid cmdline
    local -a owned=()

    while read -r pid; do
        [[ -r "/proc/$pid/cmdline" ]] || continue
        cmdline="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)"
        [[ "$cmdline" == *"input-ipc-server=$runtime_prefix"* ]] || continue
        owned+=("$pid")
    done < <(pgrep -x mpvpaper 2>/dev/null || true)

    [[ ${#owned[@]} -gt 0 ]] || return 0
    kill -TERM "${owned[@]}" 2>/dev/null || true
    for _ in {1..20}; do
        local -a alive=()
        for pid in "${owned[@]}"; do
            kill -0 "$pid" 2>/dev/null && alive+=("$pid")
        done
        [[ ${#alive[@]} -eq 0 ]] && return 0
        owned=("${alive[@]}")
        sleep 0.05
    done
    # Escalate only the instances identified by this configuration's socket path.
    kill -KILL "${owned[@]}" 2>/dev/null || true
}

# Parse args
PREVIEW=false
COLORS_PREVIEW=false
NOSWITCH=false
FORCE_DISPLAY=false
REFRESH=false
RANDOM_PICK=false
LOGIN=false
SET_MODE=""
SET_SCHEME=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --preview)  PREVIEW=true; shift ;;
        --colors-preview) COLORS_PREVIEW=true; shift ;;
        --force-display) FORCE_DISPLAY=true; shift ;;
        --noswitch) NOSWITCH=true; shift ;;
        --random) RANDOM_PICK=true; shift ;;
        --login) LOGIN=true; shift ;;
        --refresh)  REFRESH=true; NOSWITCH=true; shift ;;
        --mode)     [[ -n "${2:-}" ]] || usage; SET_MODE="$2"; shift 2 ;;
        --scheme)   [[ -n "${2:-}" ]] || usage; SET_SCHEME="$2"; shift 2 ;;
        --)         shift; break ;;
        -*)         usage ;;
        *)          break ;;
    esac
done

if $LOGIN; then
    [[ $# -eq 0 ]] || usage
    if $PREVIEW || $COLORS_PREVIEW || $NOSWITCH || $REFRESH || $RANDOM_PICK || \
        [[ -n "$SET_MODE" || -n "$SET_SCHEME" ]]; then
        usage
    fi

    random_on_login=true
    if [[ -s "$CONFIG_FILE" ]]; then
        random_on_login="$(jq -r '.wallpaper.randomOnLogin // true' "$CONFIG_FILE" 2>/dev/null || echo true)"
    fi

    if [[ "$random_on_login" == true ]]; then
        RANDOM_PICK=true
    else
        [[ -s "$STATE_FILE" ]] || exit 0
        wallpaper="$(cat "$STATE_FILE")"
        [[ -f "$wallpaper" ]] || exit 0
        PREVIEW=true
    fi
fi

if $RANDOM_PICK && ! $LOGIN; then
    [[ $# -eq 0 ]] || usage
    if $PREVIEW || $COLORS_PREVIEW || $NOSWITCH || $REFRESH || \
        [[ -n "$SET_MODE" || -n "$SET_SCHEME" ]]; then
        usage
    fi
fi

# Requested mode override. Persist it only after the matching theme succeeds.
if [[ -n "$SET_MODE" ]]; then
    case "$SET_MODE" in
        auto|light|dark) ;;
        *) echo "switchwall: --mode must be auto, light or dark (got: $SET_MODE)" >&2; exit 1 ;;
    esac
    if [[ $# -eq 0 ]] && ! $PREVIEW; then
        NOSWITCH=true
    fi
fi

COLOR_MODE=auto
if [[ -n "$SET_MODE" ]]; then
    COLOR_MODE="$SET_MODE"
elif [[ -s "$MODE_FILE" ]]; then
    COLOR_MODE="$(cat "$MODE_FILE")"
fi

if $RANDOM_PICK; then
    wallpaper_dir="$HOME/wallpaper"
    candidates=()
    while IFS= read -r -d '' candidate; do
        candidates+=("$candidate")
    done < <(find "$wallpaper_dir" -maxdepth 1 -type f \
        \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \
        -o -iname '*.mp4' -o -iname '*.webm' -o -iname '*.mkv' -o -iname '*.avi' \
        -o -iname '*.mov' \) -print0 | sort -z)

    [[ ${#candidates[@]} -gt 0 ]] || {
        echo "switchwall: no wallpapers found in $wallpaper_dir" >&2
        exit 0
    }

    if [[ ${#candidates[@]} -gt 1 && -s "$STATE_FILE" ]]; then
        current="$(cat "$STATE_FILE")"
        alternatives=()
        for candidate in "${candidates[@]}"; do
            [[ "$candidate" == "$current" ]] || alternatives+=("$candidate")
        done
        [[ ${#alternatives[@]} -eq 0 ]] || candidates=("${alternatives[@]}")
    fi

    wallpaper="${candidates[RANDOM % ${#candidates[@]}]}"
    echo "switchwall: randomly selected ${wallpaper##*/}"
elif $LOGIN; then
    : # Restore path was resolved above when login shuffling is disabled.
elif $COLORS_PREVIEW; then
    [[ $# -eq 1 ]] || usage
    wallpaper="$1"
    [[ -f "$wallpaper" ]] || { echo "switchwall: no such file: $wallpaper" >&2; exit 1; }
elif $NOSWITCH; then
    [[ $# -eq 0 ]] || usage
    [[ -s "$STATE_FILE" ]] || { echo "switchwall: --noswitch given but no wallpaper is set yet ($STATE_FILE missing/empty)" >&2; exit 1; }
    wallpaper="$(cat "$STATE_FILE")"
    [[ -f "$wallpaper" ]] || { echo "switchwall: stored wallpaper no longer exists: $wallpaper" >&2; exit 1; }
else
    [[ $# -eq 1 ]] || usage
    wallpaper="$1"
    [[ -f "$wallpaper" ]] || { echo "switchwall: no such file: $wallpaper" >&2; exit 1; }
fi

# Dependency preflight
if ! $PREVIEW; then
    for bin in matugen ffmpeg gsettings jq flock; do
        command -v "$bin" >/dev/null || { echo "switchwall: missing required binary: $bin" >&2; exit 1; }
    done
    [[ -x "$VENV_PYTHON" ]] || { echo "switchwall: venv python not found at $VENV_PYTHON" >&2; exit 1; }
fi

mkdir -p "$CACHE_DIR"

# 1. Wallpaper display
if ! $NOSWITCH && ! $COLORS_PREVIEW && { $FORCE_DISPLAY || [[ "$(cfgbool '.wallpaper.display' true)" != "false" ]]; }; then
    # Derived here only
    command -v mpvpaper >/dev/null || { echo "switchwall: missing required binary: mpvpaper" >&2; exit 1; }
    command -v flock >/dev/null || { echo "switchwall: missing required binary: flock" >&2; exit 1; }
    display_token="$$-${RANDOM}-$(date +%s%N)"
    display_token_file="$CACHE_DIR/wallpaper-display-request"
    printf '%s' "$display_token" > "$display_token_file.part.$$"
    mv "$display_token_file.part.$$" "$display_token_file"
    exec 8>"$CACHE_DIR/wallpaper-display.lock"
    flock 8
    if [[ "$(cat "$display_token_file" 2>/dev/null)" != "$display_token" ]]; then
        echo "switchwall: superseded by a newer wallpaper request"
        exit 0
    fi

    mapfile -t MONITORS < <(hyprctl monitors -j 2>/dev/null | jq -r '.[].name')
    if [[ ${#MONITORS[@]} -eq 0 ]]; then
        mapfile -t MONITORS < <(grep -oP 'hl\.monitor\(\{\s*output\s*=\s*"\K[^"]+' "$HYPR_GENERAL")
    fi
    [[ ${#MONITORS[@]} -gt 0 ]] || { echo "switchwall: no monitors found in $HYPR_GENERAL" >&2; exit 1; }

    # Stored framing
    framing="$(jq -r --arg w "$wallpaper" '.[$w] // 0.5' "$FRAMING_FILE" 2>/dev/null || echo 0.5)"
    [[ "$framing" =~ ^[0-9]+(\.[0-9]+)?$ ]] || framing=0.5
    alignx="$(awk -v v="$framing" 'BEGIN { if (v<0) v=0; if (v>1) v=1; printf "%.4f", v * 2 - 1 }')"

    stop_owned_mpvpaper
    # Own cgroup via uwsm
    for mon in "${MONITORS[@]}"; do
        sock="${XDG_RUNTIME_DIR:-/tmp}/mpvpaper-$mon.sock"
        rm -f "$sock"
        opts="$MPV_OPTS video-align-x=$alignx input-ipc-server=$sock"
        if command -v uwsm >/dev/null; then
            uwsm app -t service -a "mpvpaper-$mon" -- mpvpaper -o "$opts" "$mon" "$wallpaper"
        else
            mpvpaper -o "$opts" "$mon" "$wallpaper" &
        fi
        sleep 0.1
    done
fi

if $PREVIEW; then
    echo "switchwall: preview only ($wallpaper)"
    exit 0
fi

if ! $COLORS_PREVIEW; then
    mkdir -p "$(dirname "$STATE_FILE")"
    printf '%s' "$wallpaper" > "$STATE_FILE"
fi

# 2. Colour source
WALL_CACHE="$(wall_cache "$wallpaper")"
if $REFRESH; then
    rm -rf "$WALL_CACHE"
fi
mkdir -p "$WALL_CACHE"

colorsource="$wallpaper"
lumsource="$wallpaper"
if is_video "$wallpaper"; then
    frame="$WALL_CACHE/frame.jpg"
    [[ -s "$frame" ]] || ffmpeg -y -i "$wallpaper" -vframes 1 "$frame" >/dev/null 2>&1
    [[ -s "$frame" ]] || { echo "switchwall: ffmpeg failed to extract a frame from $wallpaper" >&2; exit 1; }
    colorsource="$frame"

    # Brightness only
    lumframe="$WALL_CACHE/lum.jpg"
    [[ -s "$lumframe" ]] || ffmpeg -y -ss 00:00:01 -i "$wallpaper" -frames:v 1 "$lumframe" >/dev/null 2>&1 || true
    if [[ -s "$lumframe" ]]; then
        lumsource="$lumframe"
    else
        lumsource="$frame"
    fi
fi

COLOR_SOURCE=dynamic
[[ -s "$SOURCE_FILE" ]] && COLOR_SOURCE="$(cat "$SOURCE_FILE")"
if [[ "$COLOR_SOURCE" != dynamic ]] && ! $COLORS_PREVIEW; then
    if [[ -n "$SET_MODE" ]]; then
        export QUICKSHELL_REQUESTED_MODE="$SET_MODE"
        exec "$(dirname "$(readlink -f "$0")")/setscheme" "$COLOR_SOURCE"
    fi
    echo "switchwall: wallpaper set; colours held by preset $COLOR_SOURCE"
    exit 0
fi

# 3. matugen templates

# Resolved once
SCHEME_PREF="${SET_SCHEME:-$(cfg '.theming.scheme' 'auto')}"
if [[ "$SCHEME_PREF" != auto ]] && [[ " $VALID_SCHEMES " != *" $SCHEME_PREF "* ]]; then
    echo "switchwall: unknown scheme '$SCHEME_PREF', falling back to auto" >&2
    SCHEME_PREF=auto
fi

SCHEME_ARGS=(--scheme scheme-tonal-spot --smart)
[[ "$SCHEME_PREF" != auto ]] && SCHEME_ARGS=(--scheme "$SCHEME_PREF")

# Answer depends on image plus both prefs
resolved_cache="$WALL_CACHE/resolved-${SCHEME_PREF}-${COLOR_MODE}.txt"
RESOLVED=()
if [[ -s "$resolved_cache" ]]; then
    mapfile -t RESOLVED < "$resolved_cache"
fi
# Older caches held two lines
if [[ ${#RESOLVED[@]} -ne 3 ]]; then
    mapfile -t RESOLVED < <("$VENV_PYTHON" "$COLORGEN_DIR/generate_colors_material.py" \
        --path "$colorsource" \
        --luminance-path "$lumsource" \
        "${SCHEME_ARGS[@]}" \
        --mode "$COLOR_MODE" \
        --print-scheme \
        --print-mode \
        --print-luminance)
    [[ ${#RESOLVED[@]} -eq 3 ]] && printf '%s\n%s\n%s\n' "${RESOLVED[0]}" "${RESOLVED[1]}" "${RESOLVED[2]}" > "$resolved_cache"
fi
[[ ${#RESOLVED[@]} -eq 3 ]] || { echo "switchwall: failed to resolve scheme/mode" >&2; exit 1; }
SCHEME="${RESOLVED[0]}"
MODE="${RESOLVED[1]}"
LUMINANCE="${RESOLVED[2]}"

if $COLORS_PREVIEW; then
    matugen image "$colorsource" --config "$PREVIEW_CONFIG" \
        --source-color-index 0 --mode "$MODE" --type "$SCHEME" >/dev/null
    echo "switchwall: colours preview written ($wallpaper)"
    exit 0
fi

# Matugen, Kitty, GTK, Qt and Hyprland outputs form one generation. Do not let
# older queued requests overwrite a newer selection. Palette-only hover
# previews write a separate file and deliberately do not participate.
if ! begin_latest_theme; then
    echo "switchwall: theme request superseded"
    exit 0
fi

matugen image "$colorsource" --source-color-index 0 --mode "$MODE" --type "$SCHEME"

# Read by the shell for panel lift
mkdir -p "$(dirname "$LUM_FILE")"
printf '%s' "$LUMINANCE" > "$LUM_FILE"

apply_gsettings "$MODE"
apply_qt "$MODE"

# 4. Kitty palette
TERM_HARMONY="$(cfg '.theming.terminalHarmony' '0.8')"
TERM_THRESHOLD="$(cfg '.theming.terminalHarmonizeThreshold' '100')"
TERM_FG_BOOST="$(cfg '.theming.terminalFgBoost' '0.35')"
TERM_FORCE_DARK="$(cfg '.theming.terminalForceDark' 'false')"

TERM_MODE="$MODE"
[[ "$TERM_FORCE_DARK" == true ]] && TERM_MODE=dark

scss="$CACHE_DIR/material_colors.scss"
"$VENV_PYTHON" "$COLORGEN_DIR/generate_colors_material.py" \
    --path "$colorsource" \
    --mode "$TERM_MODE" \
    --scheme "$SCHEME" \
    --termscheme "$COLORGEN_DIR/terminal/scheme-base.json" \
    --harmony "$TERM_HARMONY" \
    --harmonize_threshold "$TERM_THRESHOLD" \
    --term_fg_boost "$TERM_FG_BOOST" \
    --blend_bg_fg \
    > "$scss"

apply_kitty_from_scss "$scss"

# 5. Reload
if ! theme_is_latest; then
    echo "switchwall: theme request superseded before reload"
    exit 0
fi
reload_all

if [[ -n "$SET_MODE" ]]; then
    mkdir -p "$(dirname "$MODE_FILE")"
    printf '%s' "$SET_MODE" > "$MODE_FILE"
fi

echo "switchwall: done ($wallpaper)"
