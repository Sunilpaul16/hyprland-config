#!/usr/bin/env bash

set -euo pipefail

usage() {
    echo "usage: screenshot <region|full> [--edit]" >&2
    exit 1
}

# Parse args
MODE="${1:-}"
EDIT=false
[[ "${2:-}" == "--edit" ]] && EDIT=true

case "$MODE" in
    region|full) ;;
    *) usage ;;
esac

# Dependency preflight
for bin in grim slurp wl-copy jq notify-send xdg-open; do
    command -v "$bin" >/dev/null || { echo "screenshot: missing required binary: $bin" >&2; exit 1; }
done
if $EDIT && ! command -v swappy >/dev/null; then
    echo "screenshot: --edit requires swappy, which isn't installed" >&2
    exit 1
fi

SAVE_DIR="$HOME/Pictures/Screenshots"

# Region selection
if [[ "$MODE" == region ]]; then
    region="$(slurp)" || exit 0   # Esc pressed -> silent no-op, no file, no notification
    [[ -z "$region" ]] && exit 0
else
    mon="$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name')"
fi

mkdir -p "$SAVE_DIR"
OUTFILE="$SAVE_DIR/Screenshot_$(date +%Y-%m-%d_%H.%M.%S).png"

capture() {
    # $1 = output file, or "-" for stdout
    if [[ "$MODE" == region ]]; then
        grim -g "$region" "$1"
    else
        grim -o "$mon" "$1"
    fi
}

# Backgrounded for click
notify_and_open() {
    local title="$1" file="$2"
    (
        action="$(notify-send -a screenshot -i "$file" -A "default=Open" "$title" "$file")" || true
        [[ "$action" == "default" ]] && xdg-open "$file"
    ) &
    disown
}

# Capture + save/edit
if $EDIT; then
    capture - | swappy -f - -o "$OUTFILE"
    [[ -s "$OUTFILE" ]] || exit 0   # closed swappy without saving -> nothing to copy/notify
    wl-copy < "$OUTFILE"
    notify_and_open "Screenshot saved (edited)" "$OUTFILE"
else
    capture "$OUTFILE"
    wl-copy < "$OUTFILE"
    notify_and_open "Screenshot saved" "$OUTFILE"
fi
