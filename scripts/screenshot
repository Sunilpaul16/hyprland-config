#!/usr/bin/env bash

set -euo pipefail

usage() {
    echo "usage: screenshot <region|full> [--edit]" >&2
    exit 1
}

# Parse args
MODE="${1:-}"
EDIT=false
FREEZE_PID=""
TEMP_DIR=""
[[ "${2:-}" == "--edit" ]] && EDIT=true

case "$MODE" in
    region|full) ;;
    *) usage ;;
esac

# Dependency preflight
for bin in grim wl-copy notify-send; do
    command -v "$bin" >/dev/null || { echo "screenshot: missing required binary: $bin" >&2; exit 1; }
done
if [[ "$MODE" == region ]]; then
    for bin in slurp hyprpicker; do
        command -v "$bin" >/dev/null || { echo "screenshot: region mode requires $bin, which isn't installed" >&2; exit 1; }
    done
else
    for bin in hyprctl jq; do
        command -v "$bin" >/dev/null || { echo "screenshot: full mode requires $bin, which isn't installed" >&2; exit 1; }
    done
fi
if $EDIT && ! command -v swappy >/dev/null; then
    echo "screenshot: --edit requires swappy, which isn't installed" >&2
    exit 1
fi

SAVE_DIR="$HOME/Pictures/Screenshots"

# Frozen selection
stop_freeze() {
    [[ -n "$FREEZE_PID" ]] || return 0
    kill "$FREEZE_PID" 2>/dev/null || true
    wait "$FREEZE_PID" 2>/dev/null || true
    FREEZE_PID=""
}

cleanup() {
    stop_freeze
    if [[ -n "$TEMP_DIR" && -d "$TEMP_DIR" ]]; then
        rm -f -- "$TEMP_DIR/capture.png"
        rmdir -- "$TEMP_DIR" 2>/dev/null || true
    fi
}
trap cleanup EXIT
trap 'exit 130' HUP INT TERM

# Region selection
if [[ "$MODE" == region ]]; then
    # Snapshot before slurp takes focus and dismisses shell overlays.
    hyprpicker -r -z -q &
    FREEZE_PID=$!
    sleep 0.2
    region="$(slurp)" || exit 0   # Esc pressed -> silent no-op, no file, no notification
    [[ -z "$region" ]] && exit 0
else
    mon="$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name')"
    [[ -n "$mon" ]] || { echo "screenshot: couldn't determine the focused monitor" >&2; exit 1; }
fi

mkdir -p "$SAVE_DIR"
OUTFILE="$SAVE_DIR/Screenshot_$(date +%Y-%m-%d_%H.%M.%S).png"

capture() {
    # $1 = output file, or "-" for stdout
    if [[ "$MODE" == region ]]; then
        grim -g "$region" "$1"
    else
        grim -o "$mon" "$1"
    fi
}

# Backgrounded for click
notify_and_open() {
    local title="$1" file="$2"
    (
        action="$(notify-send -a screenshot -i "$file" -A "default=Open" "$title" "$file")" || true
        if [[ "$action" == "default" ]] && command -v xdg-open >/dev/null; then
            xdg-open "$file"
        fi
    ) &
    disown
}

# Capture + save/edit
if $EDIT; then
    TEMP_DIR="$(mktemp -d --tmpdir screenshot-region.XXXXXX)"
    frozen_capture="$TEMP_DIR/capture.png"
    capture "$frozen_capture"
    stop_freeze
    swappy -f "$frozen_capture" -o "$OUTFILE"
    rm -f -- "$frozen_capture"
    rmdir -- "$TEMP_DIR"
    TEMP_DIR=""
    [[ -s "$OUTFILE" ]] || exit 0   # closed swappy without saving -> nothing to copy/notify
    wl-copy < "$OUTFILE"
    notify_and_open "Screenshot saved (edited)" "$OUTFILE"
else
    capture "$OUTFILE"
    stop_freeze
    wl-copy < "$OUTFILE"
    notify_and_open "Screenshot saved" "$OUTFILE"
fi
