#!/usr/bin/env python3
"""Compose a pinned upstream shell and optional personal patches without installing it."""
import argparse
import json
from pathlib import Path
import shutil
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parents[1]
UPSTREAM = ROOT / 'quickshell/caelestia'
CUSTOMS = ROOT / 'customs'
GENERATED = ROOT / 'generated'


def run(*args, **kwargs):
    return subprocess.run(args, check=True, **kwargs)


def compose(source, destination, mode, features):
    shutil.copytree(source, destination)
    if mode == 'custom':
        for name, enabled in features.items():
            if enabled:
                patch = CUSTOMS / 'patches' / f'{name}.patch'
                run('git', 'apply', '--check', str(patch), cwd=destination)
                run('git', 'apply', str(patch), cwd=destination)


def configuration(destination, mode, features):
    shutil.copytree(CUSTOMS / 'files', destination)
    shutil.copy2(CUSTOMS / 'defaults/hyprlock-colors.conf', destination / 'hypr/hyprlock/colors.conf')
    if mode == 'upstream':
        (destination / 'caelestia/shell.json').write_text('{}\n')
        (destination / 'caelestia/hypr-vars.lua').write_text('return {}\n')
        user = destination / 'caelestia/hypr-user.lua'
        text = user.read_text()
        # Hardware remains usable when personal shortcuts and startup hooks are disabled.
        text = text.split('require("my-shortcuts")')[0]
        user.write_text(text + 'require("hyprland.keybinds")\nrequire("hyprland.gestures")\n')
    if mode == 'upstream' or not features['wallpapers']:
        shell = destination / 'caelestia/shell.json'
        settings = json.loads(shell.read_text())
        settings.setdefault('background', {})['wallpaperEnabled'] = True
        shell.write_text(json.dumps(settings, indent=2) + '\n')
        user = destination / 'caelestia/hypr-user.lua'
        user.write_text('\n'.join(line for line in user.read_text().splitlines()
                                  if 'animated-wallpaper.py restore' not in line) + '\n')
        bindings = destination / 'caelestia/my-shortcuts.lua'
        text = bindings.read_text().replace(
            'python3 ~/.config/caelestia/animated-wallpaper.py picker',
            'qs -c caelestia ipc call launcher wallpaper').replace(
            'python3 ~/.config/caelestia/animated-wallpaper.py random', 'caelestia wallpaper -r')
        bindings.write_text(text)
    if mode == 'custom' and not features['desktop-ui']:
        # The helper IPC belongs to desktop-ui; upstream's global launcher remains available.
        bindings = destination / 'caelestia/my-shortcuts.lua'
        bindings.write_text(bindings.read_text().replace(
            'qs -c caelestia ipc call launcher wallpaper',
            'qs -c caelestia ipc call drawers toggle launcher'))
    if mode == 'custom' and not features['scratchpads']:
        for name in ('my-shortcuts.lua', 'my-gestures.lua'):
            path = destination / 'caelestia' / name
            text = path.read_text().replace('qs -c caelestia ipc call hypr openLastSpecialWorkspace', 'hyprctl dispatch togglespecialworkspace magic')
            text = text.replace('qs -c caelestia ipc call hypr toggleLastSpecialWorkspace', 'hyprctl dispatch togglespecialworkspace magic')
            path.write_text(text)
    execs = destination / 'hypr/hyprland/execs.lua'
    execs.write_text(execs.read_text().replace('caelestia shell -d', '~/.local/bin/caelestia-custom-shell -d'))
    for path in [destination / 'caelestia/my-shortcuts.lua', destination / 'hypr/hyprland/keybinds.lua']:
        text = path.read_text().replace('caelestia shell -r -d',
            'qs -c caelestia kill; ~/.local/bin/caelestia-custom-shell -d').replace(
            'caelestia shell -d', '~/.local/bin/caelestia-custom-shell -d')
        path.write_text(text)


def prepare(mode, source=UPSTREAM):
    features = json.loads((CUSTOMS / 'features.json').read_text())
    known = {p.stem for p in (CUSTOMS / 'patches').glob('*.patch')}
    if set(features) != known or any(type(value) is not bool for value in features.values()):
        raise ValueError('features.json must contain one boolean for each patch')
    if mode == 'custom' and features['wallpapers'] and not features['desktop-ui']:
        raise ValueError('Legacy wallpapers need desktop-ui for the wallpaper launcher IPC')
    with tempfile.TemporaryDirectory(prefix='.compose-', dir=ROOT) as directory:
        stage = Path(directory)
        compose(source, stage / 'caelestia', mode, features)
        configuration(stage / 'files', mode, features)
        (stage / 'profile.json').write_text(json.dumps({'mode': mode, 'features': features}, indent=2) + '\n')
        old = ROOT / 'generated.previous'
        if old.exists():
            raise RuntimeError('generated.previous exists; preserve or remove it before preparing again')
        if GENERATED.exists():
            GENERATED.rename(old)
        try:
            stage.rename(GENERATED)
        except OSError:
            if old.exists():
                old.rename(GENERATED)
            raise
        if old.exists():
            shutil.rmtree(old)
    print(f'Prepared {mode} profile in {GENERATED}; installed configuration was not changed.')


def update(source, ref):
    commit = subprocess.check_output(['git', '-C', str(source), 'rev-parse', '--verify', ref + '^{commit}'], text=True).strip()
    version = subprocess.check_output(['git', '-C', str(source), 'describe', '--tags', '--abbrev=0', commit], text=True).strip().removeprefix('v')
    with tempfile.TemporaryDirectory(prefix='.upstream-', dir=ROOT) as directory:
        stage = Path(directory)
        archive = stage / 'source.tar'
        with archive.open('wb') as stream:
            run('git', '-C', str(source), 'archive', commit, stdout=stream)
        snapshot = stage / 'source'
        snapshot.mkdir()
        run('tar', '-xf', str(archive), '-C', str(snapshot))
        # Disabled legacy features must not block upstream updates.
        features = json.loads((CUSTOMS / 'features.json').read_text())
        compose(snapshot, stage / 'check', 'custom', features)
        old = stage / 'previous'
        UPSTREAM.rename(old)
        try:
            snapshot.rename(UPSTREAM)
        except OSError:
            old.rename(UPSTREAM)
            raise
        metadata = json.loads((CUSTOMS / 'upstream.json').read_text())
        metadata['commit'] = commit
        metadata['version'] = version
        (CUSTOMS / 'upstream.json').write_text(json.dumps(metadata, indent=2) + '\n')
    print(f'Updated pristine source to {commit}. Run prepare and rebuild plugins before installing.')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='command', required=True)
    prep = commands.add_parser('prepare')
    prep.add_argument('--mode', choices=['custom', 'upstream'], default='custom')
    upd = commands.add_parser('update')
    upd.add_argument('--source', type=Path, required=True)
    upd.add_argument('--ref', default='HEAD')
    build = commands.add_parser('build')
    build.add_argument('--jobs', default='2', type=str)
    quickshell = commands.add_parser('build-quickshell')
    quickshell.add_argument('--source', type=Path, required=True)
    quickshell.add_argument('--jobs', default='2')
    cli = commands.add_parser('build-cli')
    cli.add_argument('--source', type=Path, required=True)
    args = parser.parse_args()
    if args.command == 'prepare':
        prepare(args.mode)
    elif args.command == 'update':
        update(args.source.resolve(), args.ref)
    elif args.command == 'build-cli':
        source = args.source.resolve()
        module = source / 'src/caelestia'
        if not (module / '__main__.py').is_file():
            raise ValueError('Expected a Caelestia CLI source checkout')
        destination = ROOT / 'build/runtime/python/caelestia'
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copytree(module, destination, dirs_exist_ok=True,
                        ignore=shutil.ignore_patterns('__pycache__'))
        binary = ROOT / 'build/runtime/bin/caelestia'
        binary.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(ROOT / 'scripts/runtime-caelestia', binary)
        commit = subprocess.check_output(['git', '-C', str(source), 'rev-parse', 'HEAD'], text=True).strip()
        (ROOT / 'build/runtime/cli.json').write_text(json.dumps({'commit': commit}, indent=2) + '\n')
    elif args.command == 'build-quickshell':
        source = args.source.resolve()
        output = ROOT / 'build/quickshell'
        run('cmake', '-S', str(source), '-B', str(output), '-G', 'Ninja',
            '-DCMAKE_BUILD_TYPE=Release', '-DCMAKE_INSTALL_PREFIX=' + str(ROOT / 'build/runtime'),
            '-DINSTALL_QML_PREFIX=lib/qt6/qml', '-DDISTRIBUTOR=local-qt-rebuild')
        run('cmake', '--build', str(output), '-j', args.jobs)
        binary = ROOT / 'build/runtime/bin/qs'
        binary.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(output / 'src/quickshell', binary)
        commit = subprocess.check_output(['git', '-C', str(source), 'rev-parse', 'HEAD'], text=True).strip()
        qt = subprocess.check_output(['pkg-config', '--modversion', 'Qt6Core'], text=True).strip()
        (ROOT / 'build/runtime/quickshell.json').write_text(json.dumps({'commit': commit, 'qt': qt}, indent=2) + '\n')
    else:
        prefix = ROOT / 'build/runtime'
        run('cmake', '-S', str(UPSTREAM), '-B', str(ROOT / 'build/plugins'), '-G', 'Ninja',
            '-DCMAKE_BUILD_TYPE=Release', '-DENABLE_MODULES=extras;plugin',
            '-DCMAKE_INSTALL_PREFIX=' + str(prefix), '-DINSTALL_QMLDIR=lib/qt6/qml',
            '-DINSTALL_LIBDIR=lib/caelestia',
            '-DGIT_REVISION=' + json.loads((CUSTOMS / 'upstream.json').read_text())['commit'],
            '-DVERSION=' + json.loads((CUSTOMS / 'upstream.json').read_text())['version'])
        run('cmake', '--build', str(ROOT / 'build/plugins'), '-j', args.jobs)
        run('cmake', '--install', str(ROOT / 'build/plugins'))
        shutil.copy2(CUSTOMS / 'upstream.json', prefix / 'upstream.json')


if __name__ == '__main__':
    try:
        main()
    except (ValueError, RuntimeError, subprocess.CalledProcessError) as error:
        raise SystemExit(str(error))
