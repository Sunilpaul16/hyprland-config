{
    "layer": "top",
    "position": "top",
    "height": 42,
    "spacing": 4,
    "modules-left": [
        "custom/arch",
        "tray",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "custom/updater",
        "pulseaudio",
        "group/sysinfo",
        "clock",
        "custom/power_btn"
    ],
    "include": [
        "~/.config/waybar/modules.json"
    ]
}
