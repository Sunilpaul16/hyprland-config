diff --git a/custom/SidebarHotspot.qml b/custom/SidebarHotspot.qml
new file mode 100644
--- /dev/null
+++ b/custom/SidebarHotspot.qml
@@ -0,0 +1,15 @@
+import QtQuick
+
+MouseArea {
+    id: root
+
+    required property var screenState
+
+    anchors.top: parent.top
+    anchors.right: parent.right
+    width: 20
+    height: 20
+    z: 1000
+    acceptedButtons: Qt.LeftButton
+    onClicked: root.screenState.sidebar = !root.screenState.sidebar
+}
diff --git a/custom/SidebarRegion.qml b/custom/SidebarRegion.qml
new file mode 100644
--- /dev/null
+++ b/custom/SidebarRegion.qml
@@ -0,0 +1,11 @@
+import Quickshell
+
+Region {
+    required property var win
+
+    x: win.width - 20
+    y: 0
+    width: 20
+    height: 20
+    intersection: Intersection.Subtract
+}
