diff --git a/custom/WallpaperLauncher.qml b/custom/WallpaperLauncher.qml
new file mode 100644
--- /dev/null
+++ b/custom/WallpaperLauncher.qml
@@ -0,0 +1,27 @@
+import QtQuick
+import Quickshell
+import Quickshell.Io
+import Caelestia.Config
+import qs.services
+
+Scope {
+    IpcHandler {
+        target: "launcher"
+
+        function wallpaper(): void {
+            const state = ShellState.forActive();
+            const components = ShellState.componentsForActive();
+            if (!state || !components)
+                return;
+            state.launcher = true;
+            Qt.callLater(() => {
+                const search = components.find("launcherSearch");
+                if (search) {
+                    search.text = `${GlobalConfig.launcher.actionPrefix}wallpaper `;
+                    search.forceActiveFocus();
+                }
+            });
+        }
+    }
+
+}
