diff --git a/custom/WallpaperBridge.qml b/custom/WallpaperBridge.qml
new file mode 100644
--- /dev/null
+++ b/custom/WallpaperBridge.qml
@@ -0,0 +1,29 @@
+import QtQuick
+import Quickshell
+import Caelestia.Config
+
+Scope {
+    id: root
+
+    required property var gameMode
+
+    readonly property string pickerDir: Quickshell.env("HOME") + "/.cache/caelestia/video-picker"
+
+    readonly property bool videoPlaybackEnabled: gameMode.initialized && !GlobalConfig.forScreen("eDP-1").background.wallpaperEnabled && !gameMode.enabled
+    onVideoPlaybackEnabledChanged: playbackSync.restart()
+    Component.onCompleted: playbackSync.restart()
+
+    Timer {
+        id: playbackSync
+        interval: 200
+        onTriggered: Quickshell.execDetached(["python3", Quickshell.env("HOME") + "/.config/caelestia/animated-wallpaper.py", "playback-sync"])
+    }
+
+    function setRandom(): void {
+        Quickshell.execDetached(["python3", Quickshell.env("HOME") + "/.config/caelestia/animated-wallpaper.py", "random"]);
+    }
+
+    function setWallpaper(path: string): void {
+        Quickshell.execDetached(["python3", Quickshell.env("HOME") + "/.config/caelestia/animated-wallpaper.py", "set", path]);
+    }
+}
diff --git a/custom/WallpaperGameMode.qml b/custom/WallpaperGameMode.qml
new file mode 100644
--- /dev/null
+++ b/custom/WallpaperGameMode.qml
@@ -0,0 +1,30 @@
+import QtQuick
+import Quickshell
+import Quickshell.Io
+
+Scope {
+    id: root
+
+    required property var gameMode
+    property bool initialized: false
+
+    function sync(): void {
+        Quickshell.execDetached(["python3", Quickshell.env("HOME") + "/.config/caelestia/animated-wallpaper.py", "game-sync"]);
+    }
+
+    // Restore the session flag before scheduling playback or changing Hyprland.
+    FileView {
+        path: Quickshell.env("XDG_RUNTIME_DIR") + "/caelestia-wallpaper-game-mode"
+        printErrors: false
+        onLoaded: {
+            root.gameMode.enabled = true;
+            root.initialized = true;
+            root.gameMode.setDynamicConfs();
+            root.sync();
+        }
+        onLoadFailed: {
+            root.initialized = true;
+            root.sync();
+        }
+    }
+}
diff --git a/custom/WallpaperLauncher.qml b/custom/WallpaperLauncher.qml
new file mode 100644
--- /dev/null
+++ b/custom/WallpaperLauncher.qml
@@ -0,0 +1,27 @@
+import QtQuick
+import Quickshell
+import Quickshell.Io
+import Caelestia.Config
+import qs.services
+
+Scope {
+    IpcHandler {
+        target: "launcher"
+
+        function wallpaper(): void {
+            const state = ShellState.forActive();
+            const components = ShellState.componentsForActive();
+            if (!state || !components)
+                return;
+            state.launcher = true;
+            Qt.callLater(() => {
+                const search = components.find("launcherSearch");
+                if (search) {
+                    search.text = `${GlobalConfig.launcher.actionPrefix}wallpaper `;
+                    search.forceActiveFocus();
+                }
+            });
+        }
+    }
+
+}
