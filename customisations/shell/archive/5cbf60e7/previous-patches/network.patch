diff --git a/custom/NetworkScanButton.qml b/custom/NetworkScanButton.qml
new file mode 100644
--- /dev/null
+++ b/custom/NetworkScanButton.qml
@@ -0,0 +1,13 @@
+import Caelestia.I18n
+import qs.modules.nexus.common
+
+RowButton {
+    id: root
+
+    required property var network
+
+    icon: "wifi_find"
+    text: network.scanning ? Tr.tr("Scanning…") : Tr.tr("Scan for networks")
+    disabled: !network.wifiEnabled || network.scanning
+    onClicked: root.network.rescanWifi()
+}
