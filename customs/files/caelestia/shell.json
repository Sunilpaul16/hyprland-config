{
    "appearance": {
        "transparency": {
            "enabled": false
        }
    },
    "background": {
        "wallpaperEnabled": false
    },
    "bar": {
        "activeWindow": {
            "compact": false,
            "inverted": false
        },
        "clock": {
            "background": false,
            "showDate": true,
            "showSeconds": false
        },
        "persistent": true,
        "showOnHover": false,
        "statusIcons": [
            {
                "enabled": true,
                "id": "lockStatus"
            },
            {
                "enabled": false,
                "id": "audio"
            },
            {
                "enabled": false,
                "id": "microphone"
            },
            {
                "enabled": false,
                "id": "kbLayout"
            },
            {
                "enabled": false,
                "id": "network"
            },
            {
                "enabled": true,
                "id": "bluetooth"
            },
            {
                "enabled": false,
                "id": "battery"
            }
        ],
        "tray": {
            "compact": false,
            "hiddenIcons": [
                "nm-applet",
                "blueman"
            ],
            "recolour": false
        },
        "workspaces": {
            "activeTrail": true,
            "maxWindowIcons": 4,
            "occupiedBg": false,
            "showWindowsOnSpecialWorkspaces": false,
            "shown": 4
        }
    },
    "dashboard": {
        "dragThreshold": 35,
        "enabled": true,
        "showClockSeconds": false,
        "showOnHover": false,
        "showWeather": false
    },
    "general": {
        "apps": {
            "explorer": [
                "nautilus",
                "--new-window"
            ],
            "terminal": [
                "kitty"
            ]
        },
        "idle": {
            "timeouts": [
                {
                    "enabled": true,
                    "idleAction": "lock",
                    "inhibitWhenAudio": false,
                    "inhibitWhenCharging": false,
                    "respectInhibitors": true,
                    "timeout": 900
                },
                {
                    "enabled": true,
                    "idleAction": "dpms off",
                    "inhibitWhenAudio": false,
                    "inhibitWhenCharging": false,
                    "respectInhibitors": true,
                    "returnAction": "dpms on",
                    "timeout": 3600
                },
                {
                    "enabled": true,
                    "idleAction": [
                        "suspendThenHibernate"
                    ],
                    "inhibitWhenAudio": false,
                    "inhibitWhenCharging": false,
                    "respectInhibitors": true,
                    "timeout": 7200
                }
            ]
        }
    },
    "launcher": {
        "actionPrefix": "/",
        "maxShown": 5
    },
    "services": {
        "audioIncrement": 0.1,
        "clockFormat": "TwelveHour",
        "visualiserBars": 60
    }
}
