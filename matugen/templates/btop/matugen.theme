# matugen-generated btop theme — do not edit by hand, changes will be
# overwritten on the next `switchwall` run. See ~/.config/matugen/config.toml,
# [templates.btop]. Output lives at ~/.config/btop/themes/matugen.theme.
#
# Format reference: /usr/share/btop/themes/*.theme

# Empty for transparent — lets the terminal's own background/blur show
# through instead of btop painting one. Paired with theme_background =
# false in btop.conf; that setting is what actually enables this.
theme[main_bg]=""

theme[main_fg]="{{colors.on_surface.default.hex}}"
theme[title]="{{colors.primary.default.hex}}"
theme[hi_fg]="{{colors.primary.default.hex}}"
theme[selected_bg]="{{colors.primary_container.default.hex}}"
theme[selected_fg]="{{colors.on_primary_container.default.hex}}"
theme[inactive_fg]="{{colors.outline.default.hex}}"
theme[proc_misc]="{{colors.secondary.default.hex}}"

theme[cpu_box]="{{colors.primary.default.hex}}"
theme[mem_box]="{{colors.secondary.default.hex}}"
theme[net_box]="{{colors.tertiary.default.hex}}"
theme[proc_box]="{{colors.primary.default.hex}}"
theme[div_line]="{{colors.outline_variant.default.hex}}"

theme[temp_start]="{{colors.primary.default.hex}}"
theme[temp_mid]="{{colors.tertiary.default.hex}}"
theme[temp_end]="{{colors.error.default.hex}}"

theme[cpu_start]="{{colors.primary_fixed_dim.default.hex}}"
theme[cpu_mid]="{{colors.primary.default.hex}}"
theme[cpu_end]="{{colors.tertiary.default.hex}}"

theme[free_start]="{{colors.tertiary_fixed_dim.default.hex}}"
theme[free_mid]="{{colors.tertiary.default.hex}}"
theme[free_end]="{{colors.tertiary_container.default.hex}}"

theme[cached_start]="{{colors.secondary_fixed_dim.default.hex}}"
theme[cached_mid]="{{colors.secondary.default.hex}}"
theme[cached_end]="{{colors.secondary_container.default.hex}}"

theme[available_start]="{{colors.primary_fixed_dim.default.hex}}"
theme[available_mid]="{{colors.primary.default.hex}}"
theme[available_end]="{{colors.primary_container.default.hex}}"

theme[used_start]="{{colors.error.default.hex}}"
theme[used_mid]="{{colors.error.default.hex}}"
theme[used_end]="{{colors.error_container.default.hex}}"

theme[download_start]="{{colors.primary.default.hex}}"
theme[download_mid]="{{colors.secondary.default.hex}}"
theme[download_end]="{{colors.tertiary.default.hex}}"

theme[upload_start]="{{colors.tertiary.default.hex}}"
theme[upload_mid]="{{colors.secondary.default.hex}}"
theme[upload_end]="{{colors.primary.default.hex}}"
