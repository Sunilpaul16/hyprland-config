# zsh runtime state / history (never commit shell history)
zsh/.zsh_history
zsh/.zcompdump*
zsh/.z
.claude/settings.json
# caches / compiled / generated junk
__pycache__/
*.pyc
*.pyo
.cache/
*.qmlc
*.jsc

# scratch / temp
*.tmp
*.swp
*~

# local Claude Code project instructions — not published
CLAUDE.md

# personal planning/status scratch doc — pasted into browser Claude, not repo content
INDEX.md

# research notes documenting other people's repos — not my code, don't commit
references/

# secrets / credentials — belt and suspenders alongside the explicit grep scan
*.env
.env*
*token*
*secret*
*apikey*
*api_key*
*.pem
*.key
id_rsa*
id_ed25519*
*.p12
*.pfx
zsh/oh-my-zsh/

# matugen-generated theme output — regenerated by `switchwall` from the
# templates in matugen/templates/, drifts with wallpaper. Not source of
# truth; the templates are. (fuzzel_theme.ini is NOT here — it's frozen/
# static, not matugen output anymore. quickshell/shell/services/Colors.qml
# is NOT here either anymore — it's hand-written now; ColorsLoader.qml
# mutates it at runtime from colors.json, which lives outside the repo at
# ~/.local/state/quickshell/.)
hypr/colors.lua
hypr/hyprlock/colors.conf
gtk-3.0/gtk.css
gtk-4.0/gtk.css
kitty/theme.conf

# live-written runtime user preferences (services/Config.qml) — a JSON-
# backed FileView adapter the shell itself reads/writes on every setting
# change, not something to hand-edit as repo source or track history of.
quickshell/config.json

./rev
