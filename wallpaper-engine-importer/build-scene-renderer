#!/usr/bin/env bash
set -euo pipefail

ROOT="$(dirname "$(readlink -f "$0")")"
RUNTIME="$ROOT/.runtime"
SOURCE="$RUNTIME/source"
BUILD="$RUNTIME/build"
DEPS="$RUNTIME/deps"
PATCH="$ROOT/renderer-export.patch"
RENDERER_COMMIT="b016d7d1fdcf4e5fd2f9c9fa420a8aaa07fee02d"

for bin in git cmake curl bsdtar pkg-config; do
    command -v "$bin" >/dev/null || { echo "build-scene-renderer: missing $bin" >&2; exit 1; }
done

mkdir -p "$RUNTIME" "$DEPS/packages" "$DEPS/root"

# Arch users can build without sudo: download missing compile-only packages and
# extract them beneath .runtime instead of installing them system-wide.
if command -v pacman >/dev/null; then
    for package in glew glfw glm; do
        if pacman -Q "$package" >/dev/null 2>&1; then
            continue
        fi
        url="$(pacman -Sp --print-format '%l' "$package" | tail -n 1)"
        [[ "$url" == http* ]] || { echo "build-scene-renderer: no package URL for $package" >&2; exit 1; }
        archive="$DEPS/packages/$package.pkg.tar.zst"
        curl -L --fail --output "$archive" "$url"
        bsdtar -xf "$archive" -C "$DEPS/root"
    done
fi

if [[ ! -d "$SOURCE/.git" ]]; then
    git clone --recursive https://github.com/Almamu/linux-wallpaperengine.git "$SOURCE"
fi

git -C "$SOURCE" checkout --detach "$RENDERER_COMMIT"
git -C "$SOURCE" submodule update --init --recursive

if git -C "$SOURCE" apply --check "$PATCH" >/dev/null 2>&1; then
    git -C "$SOURCE" apply "$PATCH"
elif ! git -C "$SOURCE" apply --reverse --check "$PATCH" >/dev/null 2>&1; then
    echo "build-scene-renderer: source no longer matches renderer-export.patch" >&2
    exit 1
fi

export PKG_CONFIG_PATH="$DEPS/root/usr/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
export CMAKE_PREFIX_PATH="$DEPS/root/usr${CMAKE_PREFIX_PATH:+:$CMAKE_PREFIX_PATH}"
export LIBRARY_PATH="$DEPS/root/usr/lib${LIBRARY_PATH:+:$LIBRARY_PATH}"

cmake -S "$SOURCE" -B "$BUILD" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DDEMOMODE=1 \
    -DBUILD_TESTING=OFF \
    -Wno-dev
jobs="$(nproc)"
if (( jobs > 4 )); then
    jobs=4
fi
cmake --build "$BUILD" --parallel "$jobs"

echo "$BUILD/output/linux-wallpaperengine"
